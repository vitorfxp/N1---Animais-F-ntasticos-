# Copie para .env e preencha. NUNCA comite o .env real.
#   cp .env.example .env

# Servidor (acesso SSH / inventário Ansible)
SERVER_IP=203.0.113.10
SERVER_USER=root
SERVER_SSH_KEY=~/.ssh/id_ed25519

# Loopback usado pelos serviços internos (Apache -> containers)
LOCAL_HOST=127.0.0.1

# Postgres exposto pela VPN
POSTGRES_VPN_IP=10.0.0.1
POSTGRES_VPN_PORT=5439

# Metadados exibidos no mapa (API de tráfego)
SERVER_NAME=manager01
SERVER_CITY="Cidade, País"
SERVER_LAT=0.0000
SERVER_LON=0.0000
