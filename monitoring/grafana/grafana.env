# Configuração do Grafana (o deploy.sh instala em /etc/grafana/projeto.env).
# Mesma ideia da base Tamoai-Infra: tudo por variável GF_*, nada clicado na interface.

# Acesso só pelo Apache (HTTPS) em grafana.infinitymais.com.br - a porta 3000 fica local
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_DOMAIN=grafana.infinitymais.com.br
GF_SERVER_ROOT_URL=https://grafana.infinitymais.com.br
GF_SERVER_ENFORCE_DOMAIN=false

# Plugin usado no mapa de fluxo (igual ao Nimbus da base)
GF_PLUGINS_PREINSTALL_SYNC=volkovlabs-echarts-panel,volkovlabs-variable-panel,marcusolsson-json-datasource

# Segurança
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_COOKIE_SAMESITE=lax
GF_SECURITY_DISABLE_GRAVATAR=true
GF_SECURITY_STRICT_TRANSPORT_SECURITY=true
GF_SECURITY_X_CONTENT_TYPE_OPTIONS=true
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_LOGIN_MAXIMUM_INACTIVE_LIFETIME_DURATION=7d
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false

# Visual
GF_USERS_DEFAULT_THEME=dark
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/projeto/0-mapa-de-trafego.json
GF_DATE_FORMATS_DEFAULT_TIMEZONE=browser

# Painéis de texto podem usar HTML completo (scripts, iframes, estilos)
GF_PANELS_DISABLE_SANITIZE_HTML=true
