      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#E5303B"
              },
              {
                "value": 86400,
                "color": "#F5A623"
              },
              {
                "value": 604800,
                "color": "#1F9D55"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
